# Copy to .env on the server. NEVER commit .env
NODE_ENV=production
HOST=127.0.0.1
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/shopsphere
JWT_SECRET=change-me-to-a-long-random-string-32chars
JWT_EXPIRES_IN=1d
# Comma separated list of allowed frontend origins
CORS_ORIGIN=https://shop.example.com
# sandbox = simulate endpoint enabled, live = disabled
PAYMENT_MODE=sandbox
PAYMENT_WEBHOOK_SECRET=change-me-webhook-secret-32chars
# Only used by `npm run seed`
SEED_ADMIN_EMAIL=admin@shopsphere.test
SEED_ADMIN_PASSWORD=Admin@12345
